{
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "eslint": "10.6.0",
    "globals": "17.7.0",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  },
  "scripts": {
    "rag-update": "bun run ingest/rag-update.ts",
    "serve": "bun run scripts/serve.ts",
    "lint": "prettier --log-level warn --write 'src/**/*.ts' 'ingest/*.ts' && eslint --fix . && tsc --noEmit",
    "eval:retrieval": "bun run scripts/eval-retrieval.ts",
    "eval:paraphrase": "bun run scripts/eval-paraphrase.ts",
    "eval:coverage": "bun run scripts/eval-coverage.ts",
    "eval:coverage:lowercase": "bun run scripts/eval-coverage.ts --lowercase",
    "test": "bun run scripts/rerank-box.ts bun run test:evals",
    "test:evals": "bun run eval:retrieval && bun run eval:paraphrase && bun run eval:coverage && bun run eval:coverage:lowercase",
    "test:llm": "bun run scripts/eval-llm-gate.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@lancedb/lancedb": "0.31.0",
    "epub2": "3.0.2"
  },
  "trustedDependencies": [
    "onnxruntime-node"
  ]
}
